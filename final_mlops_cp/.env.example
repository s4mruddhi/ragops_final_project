# =============================================================================
# RAGOps: .env.example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local                   # "local" | "aws"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Retrieval & RAG Pipeline
# ---------------------------------------------------------------------------
RETRIEVAL_METHOD=semantic        # "semantic" | "hybrid" | "bm25" | "tfidf"
TOP_K=5                          # Number of candidate chunks to retrieve
FINAL_CONTEXT_K=3                # Top-K filtered chunks passed to LLM context
RELEVANCE_THRESHOLD=0.2          # Minimum score threshold for chunk inclusion
HYBRID_ALPHA=0.5                 # Weight for semantic score in hybrid retrieval (0=lexical, 1=dense)
ALLOW_TEST_MOCK=0                # Set to 1 only in isolated test/CI environments to use mock generator


# ---------------------------------------------------------------------------
# AWS (leave blank for local mode)
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_S3_BUCKET=
# For local dev, you can use AWS CLI profile instead of key/secret:
# AWS_PROFILE=default
# Only set these if NOT using IAM roles or AWS CLI profile:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
# Leave unset to use local sqlite (mlflow.db). To use the docker-compose MLflow server: MLFLOW_TRACKING_URI=http://localhost:5000
#MLFLOW_TRACKING_URI=http://localhost:5000
# For S3-backed MLflow artifact store:
# MLFLOW_TRACKING_URI=http://<mlflow-ec2-ip>:5000
MLFLOW_ARTIFACT_ROOT=./mlruns   # or s3://<bucket>/mlflow

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai             # "openai" | "ollama" | "huggingface"
LLM_MODEL=gpt-4o-mini           # model name for chosen provider
OPENAI_API_KEY=                 # required if LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434  # required if LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Embedding
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu            # "cpu" | "cuda"

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_NAME=ragops_v1

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ---------------------------------------------------------------------------
# Groundedness
# ---------------------------------------------------------------------------
GROUNDEDNESS_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Drift detection
# ---------------------------------------------------------------------------
DRIFT_PSI_THRESHOLD=0.2
DRIFT_KS_P_VALUE=0.05

# ---------------------------------------------------------------------------
# AWS CloudWatch (only used in aws mode)
# ---------------------------------------------------------------------------
CLOUDWATCH_LOG_GROUP=/ragops/api
CLOUDWATCH_LOG_STREAM=application

# ---------------------------------------------------------------------------
# SageMaker (only used for SageMaker job submission)
# ---------------------------------------------------------------------------
SAGEMAKER_ROLE_ARN=
SAGEMAKER_INSTANCE_TYPE=ml.t3.medium
SAGEMAKER_IMAGE_URI=           # ECR image or built-in sklearn container
