# =============================================================================
# .dockerignore
# =============================================================================

# Secrets
.env
*.pem
*.key

# Python cache
__pycache__/
*.pyc
*.pyo
.eggs/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Data (mounted as volumes in compose, not baked into image)
data/raw/
data/vectorstore/
mlruns/
mlartifacts/

# DVC cache
.dvc/cache/
.dvc/tmp/

# Test and coverage artefacts
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Docs (not needed in runtime image)
docs/
*.md

# Airflow metadata
airflow.db
airflow.cfg
logs/
